---
import { links } from '../data/site';

const quickPoints = [
  'Te ayudamos a elegir el plan segun el presupuesto y la cantidad de estudiantes.',
  'Conoce el itinerario, actividades y experiencias incluidas en la excursion.',
  'Resolvemos todas las dudas de estudiantes y padres de familia antes de iniciar el proceso.',
];

const faqs = [
  {
    question: '¿Cómo se puede pagar?',
    answer:
      'Contamos con diferentes medios de pago para facilitar el proceso. Recibimos transferencia, tarjeta, efectivo y bonos para pagar el 100% del valor del viaje, con opciones de pago flexibles durante la organización de la excursión.',
  },
  {
    question: '¿Es seguro el viaje?',
    answer:
      'Sí. Trabajamos con proveedores verificados, hoteles seleccionados y transporte autorizado. Además, brindamos acompañamiento durante todo el viaje y seguimos protocolos de organización y seguridad para tranquilidad de estudiantes y familias.',
  },
  {
    question: '¿Cuánto cuesta la excursión?',
    answer:
      'El valor depende del destino y el plan de actividades elegido. En la reunión informativa mostramos las opciones disponibles para que la promoción elija la que mejor se ajuste a su presupuesto.',
  },
];
---

<section class="relative">
  <div class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <article class="glass-card rounded-[2.2rem] p-8 text-ink">
        <p class="text-xs font-semibold uppercase tracking-[0.26em] text-ocean-dark">
          Siguiente paso
        </p>
        <h2 class="mt-3 text-2xl font-bold md:text-3xl">
          Agenda una reunion informativa
        </h2>
        <p class="mt-3 text-sm text-slate-700 md:text-base">
          Cierra la decision con datos claros de logistica, seguridad y presupuesto para toda la promocion.
        </p>

        <ul class="mt-5 space-y-2 text-sm text-slate-700">
          {quickPoints.map((item) => (
            <li class="flex items-start gap-2">
              <span class="mt-1.5 h-2.5 w-2.5 rounded-full bg-ocean"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={links.whatsapp.quote}
            target="_blank"
            rel="noreferrer"
            class="rounded-full bg-ocean px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-ocean-dark"
          >
            Cotizar por WhatsApp
          </a>
          <a
            href={links.whatsapp.meeting}
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-ocean-dark px-6 py-3 text-sm font-semibold text-ocean-dark transition hover:-translate-y-0.5 hover:bg-white/70"
          >
            Agendar reunion
          </a>
        </div>
      </article>

      <article class="rounded-[2.2rem] border border-white/70 bg-white/85 p-7 shadow-[0_16px_36px_rgba(11,110,168,0.12)]">
        <h3 class="text-xl font-bold text-ink">Preguntas frecuentes</h3>
        <div class="mt-4 space-y-3">
          {faqs.map((item) => (
            <div class="rounded-xl border border-slate-200/70 bg-white/85 px-4 py-3 shadow-sm">
              <div class="space-y-1">
                <p class="text-sm font-semibold text-ocean-dark">{item.question}</p>
                <p class="text-sm text-slate-700 leading-relaxed">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>
