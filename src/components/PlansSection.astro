---
import { plans } from '../data/site';

const planImages = [
  '/planes/imagenes/Cartagena.jpeg',
  '/planes/imagenes/Santamarta-Cartagena-avion.jpeg',
  '/planes/imagenes/SanAndres.jpeg',
  '/planes/imagenes/Santamarta-Cartagena-bus.jpeg',
  '/planes/imagenes/ejecafetero.jpeg',
  '/planes/imagenes/Sangil.jpeg',
];

const getImageForPlan = (index: number) => planImages[index % planImages.length];
const planAccentColors = ['var(--color-ocean)', 'var(--color-sun)'] as const;
const getAccentColor = (index: number) => planAccentColors[index % planAccentColors.length];
const planCardMeta = [
  { duration: '5 DIAS / 4 NOCHES', mode: 'Terrestre', icon: 'car' },
  { duration: '5 DIAS / 4 NOCHES', mode: 'Mixto', icon: 'truck-plane' },
  { duration: '4 DIAS / 3 NOCHES', mode: 'Aereo', icon: 'plane' },
  { duration: '7 DIAS', mode: 'Terrestre', icon: 'car' },
  { duration: '4 DIAS / 3 NOCHES', mode: 'Terrestre', icon: 'car' },
  { duration: '4 DIAS / 3 NOCHES', mode: 'Terrestre', icon: 'car' },
] as const;
---

<section id="planes" class="relative">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-ocean-dark">
          {plans.kicker}
        </p>
        <h2 class="mt-2 text-3xl font-bold text-ink md:text-4xl">
          Descubre destinos, hoteles y paquetes para  tu excursión
        </h2>
       
      </div>
    </div>

    <div class="payment-banner">
      <div class="payment-banner-media" aria-hidden="true">
        <img
          src="https://images.unsplash.com/photo-1612278675615-7b093b07772d?q=80&w=1169&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="payment-banner-copy">
        <div class="payment-banner-text">
          <p class="payment-banner-eyebrow">Pagos flexibles para tu promoción</p>
          <h3>Recibimos todos los medios de pago</h3>
          <p>Transferencia, tarjeta, efectivo y bonos para pagar el 100% de tu excursión.</p>
        </div>
        <div class="payment-banner-footer">
          <div class="payment-banner-icons" aria-label="Medios de pago">
            <span class="pay-pill">
              <span class="pay-icon pay-card" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none">
                  <rect x="3" y="6" width="18" height="12" rx="2.2" stroke="currentColor" stroke-width="1.6" />
                  <rect x="6" y="11" width="6" height="2" rx="0.6" fill="#F79E1B" />
                  <rect x="13" y="11" width="5" height="2" rx="0.6" fill="#EB001B" />
                </svg>
              </span>
              <span class="pay-label">Tarjeta</span>
            </span>
            <span class="pay-pill">
              <span class="pay-icon pay-transfer" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none">
                  <path d="M7 8h9M7 12h7M7 16h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  <path d="m12 5 4 3-4 3" stroke="#5CC6B0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="pay-label">Transferencia</span>
            </span>
            <span class="pay-pill">
              <span class="pay-icon pay-cash" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none">
                  <rect x="4" y="7" width="16" height="10" rx="2.2" stroke="currentColor" stroke-width="1.7" />
                  <circle cx="12" cy="12" r="2.4" fill="currentColor" />
                </svg>
              </span>
              <span class="pay-label">Efectivo</span>
            </span>
            <span class="pay-pill">
              <span class="pay-icon pay-bonus" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none">
                  <path d="M7 7.5h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.7" />
                  <path d="M12 7.5v9" stroke="#A54CE6" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M9.2 10.1c0-.95.74-1.6 1.8-1.6 1.04 0 1.8.64 1.8 1.6 0 1.86-3.6 1.15-3.6 3.3 0 .95.76 1.6 1.8 1.6 1.06 0 1.8-.65 1.8-1.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              </span>
              <span class="pay-label">Bonos</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="plan-grid">
      {plans.cards.map((card, index) => {
        const meta = planCardMeta[index] ?? planCardMeta[0];
        return (
          <article
            class:list={['plan-media-card']}
            style={`--plan-accent: ${getAccentColor(index)};`}
          >
            <div class="plan-card-media">
              <img
                src={getImageForPlan(index)}
                alt={card.title}
                loading="lazy"
                decoding="async"
                class="plan-card-image"
              />
              <div class="plan-card-overlay" aria-hidden="true"></div>
              <div class="plan-card-badge-row">
                <span class="plan-duration-badge">{meta.duration}</span>
              </div>
            </div>
            <div class="plan-card-content">
              <p class="plan-kicker">{plans.kicker}</p>
              <h3 class="plan-title">{card.title}</h3>
              <p class="plan-mode">
                <i class:list={['fa-solid', `fa-${meta.icon}`]} aria-hidden="true"></i>
                <span>{meta.mode}</span>
              </p>
              <a
                href={card.pdf.href}
                target="_blank"
                rel="noreferrer"
                class="plan-media-cta inline-flex items-center justify-center rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-[0.08em]"
              >
                Ver plan
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .plan-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    grid-auto-flow: dense;
    grid-auto-rows: 1fr;
  }

  .payment-banner {
    margin-bottom: 1.5rem;
    overflow: hidden;
    border-radius: 0.95rem;
    border: 1px solid rgba(11, 110, 168, 0.22);
    background:
      linear-gradient(95deg, #06517c 0%, #0b6ea8 38%, #17a4c4 72%, #5cc6b0 100%);
    box-shadow: 0 14px 30px rgba(11, 110, 168, 0.12);
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    align-items: stretch;
    aspect-ratio: 640 / 51;
    min-height: 0;
  }

  .payment-banner-media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
  }

  .payment-banner-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 81, 124, 0.04), rgba(6, 81, 124, 0.34));
  }

  .payment-banner-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    display: block;
  }

  .payment-banner-copy {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem 0.9rem 1rem;
    color: #ffffff;
    background:
      radial-gradient(circle at top right, rgba(255, 176, 32, 0.18), transparent 30%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0));
  }

  .payment-banner-text {
    min-width: 0;
  }

  .payment-banner-footer {
    position: static;
    width: 100%;
    justify-self: end;
    align-self: center;
    max-width: none;
  }

  .payment-banner-eyebrow {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(220, 245, 255, 0.82);
  }

  .payment-banner-copy h3 {
    margin: 0;
    font-size: clamp(0.8rem, 1.2vw, 1.2rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #ffffff;
    max-width: none;
  }

  .payment-banner-copy p {
    margin: 0;
    max-width: 40ch;
    font-size: 0.62rem;
    line-height: 1.14;
    color: rgba(245, 248, 255, 0.9);
  }

  .payment-banner-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    max-width: 230px;
    justify-content: flex-end;
  }

  .pay-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 30px;
    padding: 0 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 12px rgba(3, 37, 58, 0.14);
    backdrop-filter: blur(6px);
  }

  .pay-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 7px;
  }

  .pay-card {
    background: #f2f6ff;
    color: #1434cb;
  }

  .pay-transfer {
    background: #e8f7f3;
    color: #0b6ea8;
  }

  .pay-cash {
    background: #fff3d7;
    color: #c98600;
  }

  .pay-bonus {
    background: #f4eaff;
    color: #7c3aed;
  }

  .pay-label {
    font-size: 10.5px;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
  }

  .plan-media-card {
    position: relative;
    overflow: hidden;
    min-height: 24.5rem;
    height: 100%;
    border-radius: 1.35rem;
    border: 1px solid var(--plan-accent);
    box-shadow: 0 16px 34px color-mix(in srgb, var(--plan-accent) 20%, transparent);
    background: #ffffff;
    isolation: isolate;
    display: flex;
    flex-direction: column;
  }

  .plan-card-media {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  .plan-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1);
    transition: transform 0.5s ease;
    display: block;
  }

  .plan-card-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 20, 34, 0.08) 0%, rgba(5, 20, 34, 0.02) 62%, rgba(5, 20, 34, 0.18) 100%);
  }

  .plan-card-badge-row {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.95rem;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .plan-duration-badge {
    position: static;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    border-radius: 0.85rem;
    background: rgba(24, 30, 49, 0.74);
    color: #ffffff;
    padding: 0.58rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(12px);
  }

  .plan-card-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.82rem;
    padding: 0.95rem 0.95rem 1.1rem;
    background: #ffffff;
    border-top: 1px solid color-mix(in srgb, var(--plan-accent) 22%, white);
    flex: 1 1 auto;
  }

  .plan-kicker {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6c7c95;
  }

  .plan-title {
    margin: 0;
    color: #1f2a37;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 800;
    line-height: 1.04;
    text-wrap: balance;
  }

  .plan-mode {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #5c6e8b;
    font-size: 0.98rem;
    font-weight: 700;
  }

  .plan-mode i {
    color: var(--plan-accent);
    font-size: 0.95rem;
  }

  .plan-media-cta {
    color: #06243a;
    background: color-mix(in srgb, var(--color-mint) 84%, white 16%);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, filter 0.2s ease;
    margin-top: auto;
  }

  .plan-media-card:hover .plan-card-image {
    transform: scale(1.05);
  }

  .plan-media-card:hover {
    box-shadow: 0 22px 40px rgba(11, 110, 168, 0.16);
  }

  .plan-media-card:hover .plan-media-cta {
    transform: translateY(-2px);
    filter: brightness(1.02);
  }

  @media (min-width: 768px) {
    .plan-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .payment-banner-media {
      min-height: 100%;
    }

    .payment-banner-copy {
      gap: 0.9rem;
      padding: 1rem 1.1rem 1rem 1.1rem;
    }

    .payment-banner-eyebrow {
      font-size: 0.68rem;
    }

    .payment-banner-copy h3 {
      font-size: clamp(0.98rem, 1.25vw, 1.34rem);
      max-width: none;
    }

    .payment-banner-copy p {
      max-width: 44ch;
      font-size: 0.66rem;
      line-height: 1.14;
    }

    .payment-banner-footer { max-width: none; }
  }

@media (max-width: 1100px) {
  .payment-banner-copy {
    grid-template-columns: 1fr;
    align-items: start;
    gap: 0.7rem;
  }

  .payment-banner-footer {
    width: 100%;
    justify-self: start;
    max-width: none;
  }

  .payment-banner-icons {
    justify-content: flex-start;
    gap: 0.6rem;
    max-width: none;
  }
}

  @media (max-width: 520px) {
    .plan-media-card {
      min-height: 25.5rem;
      grid-template-rows: 12.4rem minmax(0, 1fr);
    }

    .plan-card-badge-row {
      left: 0.85rem;
      right: 0.85rem;
      bottom: 0.85rem;
    }

    .plan-duration-badge {
      font-size: 0.66rem;
      padding: 0.52rem 0.8rem;
    }

    .plan-card-content {
      gap: 0.8rem;
      padding: 0.95rem 0.9rem 1rem;
    }

    .plan-title {
      font-size: 1.28rem;
    }

    .payment-banner {
      grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
      aspect-ratio: auto;
    }

    .payment-banner-copy {
      gap: 0.6rem;
      padding: 0.65rem 0.6rem 0.7rem 0.6rem;
    }

    .payment-banner-eyebrow {
      font-size: 0.46rem;
    }

    .payment-banner-copy p {
      display: none;
    }

    .payment-banner-copy h3 {
      font-size: 0.6rem;
      line-height: 1.02;
      max-width: 14ch;
    }

    .payment-banner-footer {
      width: 100%;
    }

    .payment-banner-icons {
      justify-content: flex-start;
      max-width: none;
      gap: 0.35rem;
    }
  }

  @media (min-width: 1024px) {
    .plan-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-card-image,
    .plan-media-cta {
      transition: none !important;
    }
  }
</style>
