---
const experienceImages = [
  {
    src: '/experiencias/1.jpg',
    alt: 'Estudiantes disfrutando el mar durante la excursión',
    title: 'Mar que se recuerda',
    tag: 'Playa',
    position: '50% 74%',
  },
  {
    src: '/experiencias/2.jpeg',
    alt: 'Grupo de estudiantes viviendo una actividad de integración',
    title: 'Risas en ruta',
    tag: 'Integración',
    position: '50% 58%',
  },
  {
    src: '/experiencias/3.jpeg',
    alt: 'Promoción de grado once compartiendo una experiencia de viaje',
    title: 'La foto del curso',
    tag: 'Promoción',
    position: '50% 56%',
  },
  {
    src: '/experiencias/4.jpeg',
    alt: 'Estudiantes en una actividad recreativa al aire libre',
    title: 'Retos con amigos',
    tag: 'Aventura',
    position: '50% 58%',
  },
  {
    src: '/experiencias/5.jpeg',
    alt: 'Actividad de grupo en la playa con acompañamiento',
    title: 'Juegos de playa',
    tag: 'Dinámicas',
    position: '50% 55%',
  },
  {
    src: '/experiencias/6.jpeg',
    alt: 'Momentos de excursión junto al mar',
    title: 'Sol, agua y equipo',
    tag: 'Caribe',
    position: '50% 58%',
  },
  {
    src: '/experiencias/7.jpeg',
    alt: 'Estudiantes compartiendo en destino durante su excursión',
    title: 'Días sin pausa',
    tag: 'Recuerdos',
    position: '50% 56%',
  },
  {
    src: '/experiencias/8.jpeg',
    alt: 'Grupo de estudiantes en una celebración temática',
    title: 'Noche de promoción',
    tag: 'Celebración',
    position: '50% 62%',
  },
];

const experienceMoments = [
  {
    icon: 'fa-water',
    title: 'Actividades acuáticas',
    text: 'Playas, piscina, fotos grupales y momentos frescos pensados para que todo el curso participe.',
  },
  {
    icon: 'fa-people-group',
    title: 'Integración real',
    text: 'Dinámicas por equipos, retos en playa y espacios donde el grupo se conecta fuera del salón.',
  },
  {
    icon: 'fa-music',
    title: 'Celebraciones temáticas',
    text: 'Noches especiales, dress code, música y recuerdos que cierran el viaje con energía de promoción.',
  },
];

const featuredImages = [experienceImages[1], experienceImages[4], experienceImages[7]];
---

<section id="experiencias" class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="experience-hero">
      <div class="experience-hero-media">
        <img
          src={experienceImages[0].src}
          alt={experienceImages[0].alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          style={`object-position: ${experienceImages[0].position};`}
        />
        <div class="experience-hero-shade" aria-hidden="true"></div>
      </div>

      <div class="experience-hero-copy">
        <p class="experience-kicker">Experiencias reales</p>
        <h2>La excursión se cuenta mejor cuando ya parece recuerdo.</h2>
        <p>
          Convertimos el viaje de grado 11 en una secuencia de momentos: mar, juegos,
          celebración, fotos y acompañamiento para que cada estudiante tenga una historia que contar.
        </p>
        <div class="experience-hero-actions">
          <span class="experience-badge">8 momentos destacados</span>
        </div>
      </div>

      <div class="experience-polaroids" aria-label="Momentos destacados">
        {featuredImages.map((image, index) => (
          <button
            class:list={['experience-polaroid', `experience-polaroid-${index + 1}`]}
            type="button"
            data-lightbox-src={image.src}
            data-lightbox-alt={image.alt}
            data-lightbox-title={image.title}
          >
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              style={`object-position: ${image.position};`}
            />
            <span>{image.tag}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="experience-strip" aria-label="Galería de experiencias">
      {experienceImages.map((image, index) => (
        <button
          class="experience-strip-item"
          type="button"
          data-lightbox-src={image.src}
          data-lightbox-alt={image.alt}
          data-lightbox-title={image.title}
          style={`--moment-index: '${String(index + 1).padStart(2, '0')}';`}
        >
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            decoding="async"
            style={`object-position: ${image.position};`}
          />
          <span>{image.tag}</span>
        </button>
      ))}
    </div>

    <div class="experience-story">
      <div class="experience-story-copy">
        <p class="experience-kicker">Así se vive</p>
        <h3>Una agenda que mezcla emoción, descanso y unión de grupo.</h3>
        <p>
          Diseñamos experiencias que se sienten espontáneas, pero están coordinadas con logística,
          tiempos claros y acompañamiento. La creatividad aparece en los momentos; la tranquilidad,
          en cómo los organizamos.
        </p>
      </div>

      <div class="experience-moment-grid">
        {experienceMoments.map((moment) => (
          <article class="experience-moment-card">
            <span class="experience-moment-icon">
              <i class:list={['fa-solid', moment.icon]} aria-hidden="true"></i>
            </span>
            <h4>{moment.title}</h4>
            <p>{moment.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>

  <div class="experience-lightbox" hidden>
    <button class="experience-lightbox-close" type="button" aria-label="Cerrar imagen">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <figure>
      <img src="" alt="" />
      <figcaption></figcaption>
    </figure>
  </div>
</section>

<style>
  .experience-hero {
    position: relative;
    min-height: 34rem;
    overflow: hidden;
    border-radius: 1.4rem;
    background: #06243a;
    box-shadow: 0 24px 55px rgba(11, 110, 168, 0.2);
    isolation: isolate;
  }

  .experience-hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .experience-hero-media img,
  .experience-polaroid img,
  .experience-strip-item img,
  .experience-lightbox img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .experience-hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(3, 27, 45, 0.88) 0%, rgba(3, 27, 45, 0.58) 44%, rgba(3, 27, 45, 0.18) 100%),
      linear-gradient(180deg, rgba(3, 27, 45, 0.08) 0%, rgba(3, 27, 45, 0.68) 100%);
  }

  .experience-hero-copy {
    max-width: 35rem;
    padding: clamp(2rem, 5vw, 4.5rem);
    color: #ffffff;
  }

  .experience-kicker {
    margin: 0;
    color: var(--color-sun);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .experience-hero-copy h2,
  .experience-story-copy h3 {
    margin: 0.75rem 0 0;
    font-weight: 800;
    line-height: 0.98;
    text-wrap: balance;
  }

  .experience-hero-copy h2 {
    max-width: 12ch;
    font-size: clamp(2.5rem, 7vw, 5.4rem);
    color: #ffffff;
  }

  .experience-hero-copy p:not(.experience-kicker),
  .experience-story-copy p {
    margin: 1.05rem 0 0;
    max-width: 54ch;
    color: rgba(245, 248, 255, 0.88);
    font-size: 1rem;
    line-height: 1.7;
  }

  .experience-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }

  .experience-badge {
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.14);
    padding: 0 1rem;
    color: #ffffff;
    font-size: 0.76rem;
    font-weight: 700;
    backdrop-filter: blur(10px);
  }

  .experience-polaroids {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: clamp(1rem, 4vw, 2.5rem);
    display: grid;
    width: min(36vw, 25rem);
    min-width: 18rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .experience-polaroid,
  .experience-strip-item {
    position: relative;
    overflow: hidden;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: #ffffff;
    color: #ffffff;
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.24);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .experience-polaroid {
    aspect-ratio: 3 / 4;
    border-radius: 0.85rem;
    border: 5px solid #ffffff;
  }

  .experience-polaroid::after,
  .experience-strip-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 46%, rgba(3, 27, 45, 0.76) 100%);
  }

  .experience-polaroid span,
  .experience-strip-item span {
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.55rem;
    z-index: 1;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
  }

  .experience-polaroid-1 {
    transform: translateY(1.6rem) rotate(-5deg);
  }

  .experience-polaroid-2 {
    transform: translateY(-0.5rem) rotate(3deg);
  }

  .experience-polaroid-3 {
    transform: translateY(1rem) rotate(6deg);
  }

  .experience-polaroid:hover,
  .experience-strip-item:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 22px 40px rgba(0, 0, 0, 0.28);
  }

  .experience-strip {
    margin-top: 1.15rem;
    display: grid;
    grid-template-columns: repeat(8, minmax(8.8rem, 1fr));
    gap: 0.75rem;
    overflow-x: auto;
    padding: 0.2rem 0 0.95rem;
    scrollbar-width: thin;
  }

  .experience-strip-item {
    aspect-ratio: 4 / 5;
    border-radius: 0.9rem;
    min-width: 8.8rem;
  }

  .experience-strip-item::before {
    content: var(--moment-index);
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    color: #06243a;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .experience-story {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 2rem;
    align-items: start;
    margin-top: 3.5rem;
  }

  .experience-story-copy {
    position: sticky;
    top: 10rem;
    padding-top: 0.4rem;
  }

  .experience-story-copy h3 {
    max-width: 14ch;
    color: var(--color-ink);
    font-size: clamp(2rem, 4.6vw, 4rem);
  }

  .experience-story-copy p {
    color: #56657a;
  }

  .experience-moment-grid {
    display: grid;
    gap: 1rem;
  }

  .experience-moment-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.15rem 1rem;
    align-items: start;
    border-radius: 1rem;
    border: 1px solid rgba(11, 110, 168, 0.16);
    background: rgba(255, 255, 255, 0.82);
    padding: 1.15rem;
    box-shadow: 0 16px 34px rgba(11, 110, 168, 0.1);
  }

  .experience-moment-icon {
    grid-row: span 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--color-mint) 82%, white 18%);
    color: #06243a;
    font-size: 1.05rem;
  }

  .experience-moment-card:nth-child(2) .experience-moment-icon {
    background: color-mix(in srgb, var(--color-sun) 78%, white 22%);
  }

  .experience-moment-card:nth-child(3) .experience-moment-icon {
    background: color-mix(in srgb, var(--color-coral) 72%, white 28%);
    color: #ffffff;
  }

  .experience-moment-card h4 {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.1rem;
    font-weight: 800;
  }

  .experience-moment-card p {
    margin: 0.25rem 0 0;
    color: #5c6e8b;
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .experience-lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: rgba(3, 27, 45, 0.88);
    backdrop-filter: blur(12px);
  }

  .experience-lightbox[hidden] {
    display: none;
  }

  .experience-lightbox figure {
    margin: 0;
    width: min(92vw, 64rem);
  }

  .experience-lightbox img {
    max-height: 82vh;
    border-radius: 1rem;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.45);
  }

  .experience-lightbox figcaption {
    margin-top: 0.8rem;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
  }

  .experience-lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    cursor: pointer;
  }

  @media (max-width: 920px) {
    .experience-hero {
      min-height: auto;
      display: grid;
      padding-bottom: 1rem;
    }

    .experience-hero-media {
      position: relative;
      min-height: 24rem;
    }

    .experience-hero-shade {
      background: linear-gradient(180deg, rgba(3, 27, 45, 0.18), rgba(3, 27, 45, 0.82));
    }

    .experience-hero-copy {
      padding: 1.4rem;
      margin-top: -13rem;
    }

    .experience-hero-copy h2 {
      max-width: 11ch;
    }

    .experience-polaroids {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      min-width: 0;
      padding: 0 1rem 0.5rem;
    }

    .experience-polaroid-1,
    .experience-polaroid-2,
    .experience-polaroid-3,
    .experience-polaroid:hover {
      transform: none;
    }

    .experience-story {
      grid-template-columns: 1fr;
    }

    .experience-story-copy {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .experience-hero {
      border-radius: 1rem;
    }

    .experience-hero-media {
      min-height: 22rem;
    }

    .experience-hero-copy {
      padding: 1.1rem;
      margin-top: -12rem;
    }

    .experience-hero-copy h2 {
      font-size: 2.35rem;
    }

    .experience-hero-copy p:not(.experience-kicker),
    .experience-story-copy p {
      font-size: 0.92rem;
      line-height: 1.58;
    }

    .experience-polaroids {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.45rem;
    }

    .experience-polaroid {
      border-width: 3px;
      border-radius: 0.65rem;
    }

    .experience-polaroid span {
      left: 0.45rem;
      right: 0.45rem;
      bottom: 0.4rem;
      font-size: 0.56rem;
    }

    .experience-strip {
      grid-template-columns: repeat(8, minmax(7.2rem, 1fr));
    }

    .experience-strip-item {
      min-width: 7.2rem;
      border-radius: 0.75rem;
    }

    .experience-story {
      margin-top: 2.4rem;
    }

    .experience-moment-card {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

    .experience-moment-icon {
      grid-row: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-polaroid,
    .experience-strip-item {
      transition: none !important;
    }
  }
</style>

<script>
  const lightbox = document.querySelector<HTMLElement>('.experience-lightbox');
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>('img');
  const lightboxCaption = lightbox?.querySelector<HTMLElement>('figcaption');
  const closeButton = lightbox?.querySelector<HTMLButtonElement>('.experience-lightbox-close');
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]');

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!lightbox || !lightboxImage || !lightboxCaption) return;
      lightboxImage.src = trigger.dataset.lightboxSrc ?? '';
      lightboxImage.alt = trigger.dataset.lightboxAlt ?? '';
      lightboxCaption.textContent = trigger.dataset.lightboxTitle ?? '';
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  closeButton?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });
</script>
